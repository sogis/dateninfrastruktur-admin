INTERLIS 2.4;

/** Identitaeten, Zustaendigkeiten, Zugriffsrechte und dauerhafte Entscheide.
 * Datenzugriff bleibt am Dataset verankert, nicht an Ausgabe oder Version.
 * submit_data und manage_submitters sind eigenstaendige Berechtigungen.
 * Office wird aus Organization referenziert; Principal bleibt UUID-basiert.
 * Keine Anmeldedaten, Runner-Leases oder DB-Auditzeilen im Fachmodell.
 */
MODEL SO_AGI_DataInfrastructure_Access_20261112 (en)
  AT "https://geo.so.ch/models/AGI" VERSION "2026-11-12" =
  IMPORTS SO_AGI_DataInfrastructure_Organization_20261112,
          SO_AGI_DataInfrastructure_Catalog_20261112;

  DOMAIN
    EventTime = FORMAT INTERLIS.XMLDateTime "1582-01-01T00:00:00.000" .. "2999-12-31T23:59:59.999";

  TOPIC Access =
    BASKET OID AS INTERLIS.UUIDOID;
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON SO_AGI_DataInfrastructure_Organization_20261112.Organization,
               SO_AGI_DataInfrastructure_Catalog_20261112.Catalog;

    CLASS Principal =
      kind : MANDATORY (user, group, service);
      issuer : MANDATORY TEXT*1024;
      subject : MANDATORY TEXT*255;
      displayName : TEXT*255;
      active : MANDATORY BOOLEAN;
      provisionedAt : MANDATORY EventTime;
      UNIQUE issuer, subject;
    END Principal;

    CLASS GroupMembership =
      validFrom : MANDATORY EventTime;
      validUntil : EventTime;
      revokedAt : EventTime;
      reason : MANDATORY MTEXT;
      MANDATORY CONSTRAINT NOT (DEFINED(validUntil)) OR validFrom < validUntil;
      MANDATORY CONSTRAINT RevocationAfterStart:
        NOT (DEFINED(revokedAt)) OR validFrom <= revokedAt;
    END GroupMembership;

    CLASS AuthorityAssignment =
      capability : MANDATORY (manage_metadata, publish, manage_access, submit_data, manage_submitters);
      revocationReason : MTEXT;
      validFrom : MANDATORY EventTime;
      validUntil : EventTime;
      revokedAt : EventTime;
      reason : MANDATORY MTEXT;
      MANDATORY CONSTRAINT NOT (DEFINED(validUntil)) OR validFrom < validUntil;
      MANDATORY CONSTRAINT RevocationAfterStart:
        NOT (DEFINED(revokedAt)) OR validFrom <= revokedAt;
    END AuthorityAssignment;

    CLASS AccessRequest =
      reason : MANDATORY MTEXT;
      requestedAt : MANDATORY EventTime;
      requestedValidUntil : EventTime;
      status : MANDATORY (pending, approved, denied, cancelled);
      MANDATORY CONSTRAINT NOT (DEFINED(requestedValidUntil)) OR requestedAt < requestedValidUntil;
    END AccessRequest;

    CLASS AccessDecision =
      kind : MANDATORY (approve, deny, direct_grant, revoke);
      decidedAt : MANDATORY EventTime;
      reason : MANDATORY MTEXT;
      commandId : MANDATORY INTERLIS.UUIDOID;
      UNIQUE commandId;
    END AccessDecision;

    CLASS AccessGrant =
      permission : MANDATORY (read_data);
      validFrom : MANDATORY EventTime;
      validUntil : EventTime;
      revokedAt : EventTime;
      MANDATORY CONSTRAINT NOT (DEFINED(validUntil)) OR validFrom < validUntil;
      MANDATORY CONSTRAINT RevocationAfterStart:
        NOT (DEFINED(revokedAt)) OR validFrom <= revokedAt;
    END AccessGrant;

    CLASS CatalogAction =
      performedAt : MANDATORY EventTime;
      actionCode : MANDATORY (publish, archive, change_access_level, withdraw_version, withdraw_distribution, accept_delivery);
      reason : MANDATORY MTEXT;
      commandId : MANDATORY INTERLIS.UUIDOID;
      UNIQUE commandId;
    END CatalogAction;

    ASSOCIATION MembershipGroup =
      group -- {1} Principal;
      membershipsAsGroup -- {0..*} GroupMembership;
    END MembershipGroup;

    ASSOCIATION MembershipMember =
      member -- {1} Principal;
      membershipsAsMember -- {0..*} GroupMembership;
    END MembershipMember;

    ASSOCIATION MembershipRevoker =
      revokedBy -- {0..1} Principal;
      revokedMemberships -- {0..*} GroupMembership;
    END MembershipRevoker;

    ASSOCIATION AuthorityPrincipal =
      principal -- {1} Principal;
      authorities -- {0..*} AuthorityAssignment;
    END AuthorityPrincipal;

    ASSOCIATION AuthorityActor =
      assignedBy -- {1} Principal;
      assignedAuthorities -- {0..*} AuthorityAssignment;
    END AuthorityActor;

    ASSOCIATION AuthorityRevoker =
      revokedBy -- {0..1} Principal;
      revokedAuthorities -- {0..*} AuthorityAssignment;
    END AuthorityRevoker;

    ASSOCIATION AuthorityOffice =
      office (EXTERNAL) -- {0..1} SO_AGI_DataInfrastructure_Organization_20261112.Organization.Office;
      officeAuthorities -- {0..*} AuthorityAssignment;
    END AuthorityOffice;

    ASSOCIATION AuthorityDataset =
      dataset (EXTERNAL) -- {0..1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Dataset;
      datasetAuthorities -- {0..*} AuthorityAssignment;
    END AuthorityDataset;

    ASSOCIATION RequestApplicant =
      applicant -- {1} Principal;
      requests -- {0..*} AccessRequest;
    END RequestApplicant;

    ASSOCIATION DecisionBeneficiary =
      beneficiary -- {1} Principal;
      decisionsFor -- {0..*} AccessDecision;
    END DecisionBeneficiary;

    ASSOCIATION DecisionActor =
      actor -- {1} Principal;
      decisionsBy -- {0..*} AccessDecision;
    END DecisionActor;

    ASSOCIATION DecisionRequest =
      request -- {0..1} AccessRequest;
      decisions -- {0..*} AccessDecision;
    END DecisionRequest;

    ASSOCIATION DecisionSupersedes =
      supersedes -- {0..1} AccessDecision;
      supersededBy -- {0..*} AccessDecision;
    END DecisionSupersedes;

    ASSOCIATION GrantBeneficiary =
      beneficiary -- {1} Principal;
      grants -- {0..*} AccessGrant;
    END GrantBeneficiary;

    ASSOCIATION GrantDecision =
      grantingDecision -- {1} AccessDecision;
      issuedGrants -- {0..*} AccessGrant;
    END GrantDecision;

    ASSOCIATION GrantRevocation =
      revocationDecision -- {0..1} AccessDecision;
      revokedGrants -- {0..*} AccessGrant;
    END GrantRevocation;

    ASSOCIATION ActionActor =
      actor -- {1} Principal;
      catalogActions -- {0..*} CatalogAction;
    END ActionActor;

    ASSOCIATION ActionInitiator =
      initiator -- {0..1} Principal;
      initiatedCatalogActions -- {0..*} CatalogAction;
    END ActionInitiator;

    ASSOCIATION ActionVersion =
      affectedVersion (EXTERNAL) -- {0..1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.DataVersion;
      versionActions -- {0..*} CatalogAction;
    END ActionVersion;

    ASSOCIATION ActionDistribution =
      affectedDistribution (EXTERNAL) -- {0..1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Distribution;
      distributionActions -- {0..*} CatalogAction;
    END ActionDistribution;

    ASSOCIATION AccessRequestDataset =
      dataset (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Dataset;
      accessrequests -- {0..*} AccessRequest;
    END AccessRequestDataset;

    ASSOCIATION AccessDecisionDataset =
      dataset (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Dataset;
      accessdecisions -- {0..*} AccessDecision;
    END AccessDecisionDataset;

    ASSOCIATION AccessGrantDataset =
      dataset (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Dataset;
      accessgrants -- {0..*} AccessGrant;
    END AccessGrantDataset;

    ASSOCIATION CatalogActionDataset =
      dataset (EXTERNAL) -- {1} SO_AGI_DataInfrastructure_Catalog_20261112.Catalog.Dataset;
      catalogactions -- {0..*} CatalogAction;
    END CatalogActionDataset;

    CONSTRAINTS OF AuthorityAssignment =
      MANDATORY CONSTRAINT AuthorityRevocationComplete:
        (DEFINED(revokedAt) AND DEFINED(revokedBy) AND DEFINED(revocationReason)) OR NOT (DEFINED(revokedAt) OR DEFINED(revokedBy) OR DEFINED(revocationReason));
      MANDATORY CONSTRAINT AuthorityScopeExclusive:
        (DEFINED(office) OR DEFINED(dataset)) AND NOT (DEFINED(office) AND DEFINED(dataset));
    END;
    CONSTRAINTS OF GroupMembership =
      MANDATORY CONSTRAINT group->kind == #group;
      MANDATORY CONSTRAINT GroupCannotBeMember: member->kind != #group;
      MANDATORY CONSTRAINT (DEFINED(revokedAt) AND DEFINED(revokedBy)) OR NOT (DEFINED(revokedAt) OR DEFINED(revokedBy));
    END;
    CONSTRAINTS OF AccessRequest =
      MANDATORY CONSTRAINT applicant->kind == #user;
    END;
    CONSTRAINTS OF AccessDecision =
      MANDATORY CONSTRAINT ((kind == #approve OR kind == #deny) AND DEFINED(request)) OR ((kind == #direct_grant OR kind == #revoke) AND NOT (DEFINED(request)));
    END;
    CONSTRAINTS OF AccessGrant =
      MANDATORY CONSTRAINT (DEFINED(revokedAt) AND DEFINED(revocationDecision)) OR NOT (DEFINED(revokedAt) OR DEFINED(revocationDecision));
      MANDATORY CONSTRAINT GrantDecisionKind:
        grantingDecision->kind == #approve OR grantingDecision->kind == #direct_grant;
      MANDATORY CONSTRAINT RevocationDecisionKind:
        NOT (DEFINED(revocationDecision)) OR revocationDecision->kind == #revoke;
    END;

  END Access;
END SO_AGI_DataInfrastructure_Access_20261112.