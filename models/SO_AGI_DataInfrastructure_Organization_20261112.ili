INTERLIS 2.4;

/** Eigenstaendig importierbare und exportierbare Amtsstammdaten.
 * Office und ContactPoint verwenden Text-OIDs mit bis zu 200 Zeichen.
 * identifier ist eine fachliche Kennung; OID und identifier duerfen gleich
 * sein, muessen es aber nicht. Kontaktstellen sind von Amtsstammdaten unabhängig.
 */
MODEL SO_AGI_DataInfrastructure_Organization_20261112 (en)
  AT "https://geo.so.ch/models/AGI" VERSION "2026-11-12" =

  DOMAIN
    DIOID = OID TEXT*200;
    Identifier = TEXT*255;

  TOPIC Organization =
    BASKET OID AS INTERLIS.UUIDOID;
    OID AS SO_AGI_DataInfrastructure_Organization_20261112.DIOID;

    CLASS Office =
      identifier : MANDATORY Identifier;
      name : MANDATORY TEXT*255;
      abbreviation : MANDATORY TEXT*32;
      email : INTERLIS.URI;
      phone : TEXT*64;
      website : INTERLIS.URI;
      active : MANDATORY BOOLEAN;
      UNIQUE identifier;
      UNIQUE abbreviation;
    END Office;

    CLASS ContactPoint =
      name : MANDATORY TEXT*255;
      unit : TEXT*255;
      email : INTERLIS.URI;
      phone : TEXT*64;
      url : INTERLIS.URI;
    END ContactPoint;

  END Organization;

END SO_AGI_DataInfrastructure_Organization_20261112.