INTERLIS 2.4;
/** Management catalogue. UUID-OIDs are stable public identities.
 * EventTime is DATETIME in UTC; timezone normalization is an application/DB contract.
 * Vocabularies copied without code changes from the pinned vendor Base model.
 */
MODEL SO_AGI_DataInfrastructure_Catalog_20261105 (en)
  AT "https://geo.so.ch/models/AGI" VERSION "2026-11-05" =
  DOMAIN
    Identifier = TEXT*255;
    AccessLevel = (open, restricted);
    PublicationStatus = (draft, in_review, published, archived);
    DatasetKind = (standalone, series);
    Availability = (prepared, available, withdrawn);
    DistributionFormat = (csv, xlsx, parquet, other);
    Sha256 = TEXT*64;
    SafeFileName = TEXT*128;
    EventTime = FORMAT INTERLIS.XMLDateTime "1582-01-01T00:00:00.000" .. "2999-12-31T23:59:59.999";
    NonNegative = 0 .. 999999999999999999;
    Positive = 1 .. 999999999;
    Origin = (
      !!@ ili2db.dispName=Bund
      federal,
      !!@ ili2db.dispName=Kanton
      cantonal,
      !!@ ili2db.dispName=Gemeinde
      municipal,
      !!@ ili2db.dispName=Weitere
      other
    );

    MaintenanceFrequencyCode = (
      !!@ ili2db.dispName=kontinuierlich
      continual,
      !!@ ili2db.dispName=täglich
      daily,
      !!@ ili2db.dispName=wöchentlich
      weekly,
      !!@ ili2db.dispName=zweiwöchentlich
      biweekly,
      !!@ ili2db.dispName=monatlich
      monthly,
      !!@ ili2db.dispName=quartalsweise
      quarterly,
      !!@ ili2db.dispName=halbjährlich
      biannually,
      !!@ ili2db.dispName=jährlich
      annually,
      !!@ ili2db.dispName="bei Bedarf"
      asNeeded,
      !!@ ili2db.dispName=unregelmässig
      irregular,
      !!@ ili2db.dispName="nicht geplant"
      notPlanned,
      !!@ ili2db.dispName=unbekannt
      unknown
    );

    Theme = (
      !!@ ili2db.dispName="Arbeit und Erwerb"
      Arbeit_Erwerb,
      !!@ ili2db.dispName="Bau- und Wohnungswesen"
      Bau_und_Wohnungswesen,
      !!@ ili2db.dispName=Bevölkerung
      Bevoelkerung,
      !!@ ili2db.dispName="Bildung und Wissenschaft"
      Bildung_Wissenschaft,
      !!@ ili2db.dispName=Energie
      Energie,
      !!@ ili2db.dispName=Finanzen
      Finanzen,
      !!@ ili2db.dispName=Geografie
      Geografie,
      !!@ ili2db.dispName=Gesetzgebung
      Gesetzgebung,
      !!@ ili2db.dispName=Gesundheit
      Gesundheit,
      !!@ ili2db.dispName=Handel
      Handel,
      !!@ ili2db.dispName="Industrie und Dienstleistungen"
      Industrie_und_Dienstleistungen,
      !!@ ili2db.dispName="Kriminalität und Strafrecht"
      Kriminalitaet_Strafrecht,
      !!@ ili2db.dispName="Kultur, Medien, Informationsgesellschaft und Sport"
      Kultur_Medien_Informationsgesellschaft_Sport,
      !!@ ili2db.dispName="Landwirtschaft und Forstwirtschaft"
      Landwirtschaft_Forstwirtschaft,
      !!@ ili2db.dispName="Mobilität und Verkehr"
      Mobilitaet_und_Verkehr,
      !!@ ili2db.dispName="Öffentliche Ordnung und Sicherheit"
      Oeffentliche_Ordnung_und_Sicherheit,
      !!@ ili2db.dispName=Politik
      Politik,
      !!@ ili2db.dispName=Preise
      Preise,
      !!@ ili2db.dispName="Raum und Umwelt"
      Raum_und_Umwelt,
      !!@ ili2db.dispName="Soziale Sicherheit"
      Soziale_Sicherheit,
      !!@ ili2db.dispName="Statistische Grundlagen"
      Statistische_Grundlagen,
      !!@ ili2db.dispName=Tourismus
      Tourismus,
      !!@ ili2db.dispName=Verwaltung
      Verwaltung,
      !!@ ili2db.dispName=Volkswirtschaft
      Volkswirtschaft
    );

  TOPIC Catalog =
    OID AS INTERLIS.UUIDOID;
    !!@ di.audit=full
    CLASS Office =
      identifier : MANDATORY Identifier;
      name : MANDATORY TEXT*255;
      abbreviation : MANDATORY TEXT*32;
      email : INTERLIS.URI;
      phone : TEXT*64;
      website : INTERLIS.URI;
      active : MANDATORY BOOLEAN;
      UNIQUE identifier;
      UNIQUE abbreviation;
    END Office;

    !!@ di.audit=full
    CLASS Dataset =
      identifier : MANDATORY Identifier;
      kind : MANDATORY DatasetKind;
      title : MANDATORY TEXT*255;
      description : MANDATORY MTEXT;
      contactName : TEXT*255;
      contactUnit : TEXT*255;
      contactEmail : MANDATORY INTERLIS.URI;
      contactPhone : TEXT*64;
      contactUrl : INTERLIS.URI;
      accessLevel : MANDATORY AccessLevel;
      publicationStatus : MANDATORY PublicationStatus;
      origin : Origin;
      frequency : MaintenanceFrequencyCode;
      issued : DATE;
      modified : MANDATORY DATE;
      licenseUri : INTERLIS.URI;
      surveyMethod : MTEXT;
      furtherUses : MTEXT;
      auxiliaryData : MTEXT;
      dataAvailableFrom : TEXT*255;
      UNIQUE identifier;
    END Dataset;

    !!@ di.audit=full
    CLASS DatasetIssue =
      issueKey : MANDATORY TEXT*128;
      label : MANDATORY TEXT*255;
      publicationStatus : MANDATORY PublicationStatus;
      referenceDate : DATE;
      startDate : DATE;
      endDate : DATE;
      note : MTEXT;
      issued : DATE;
      modified : MANDATORY DATE;
      MANDATORY CONSTRAINT NOT (DEFINED(referenceDate) AND (DEFINED(startDate) OR DEFINED(endDate)));
      MANDATORY CONSTRAINT NOT (DEFINED(startDate) AND DEFINED(endDate)) OR startDate <= endDate;
    END DatasetIssue;

    !!@ di.audit=full
    CLASS DataSchema =
      identifier : MANDATORY Identifier;
      modelName : TEXT*255;
      modelUri : INTERLIS.URI;
      modelVersion : TEXT*100;
      modelSha256 : Sha256;
      description : MTEXT;
      UNIQUE identifier;
    END DataSchema;

    !!@ di.audit=full
    CLASS CsvDeliveryConfiguration =
      enabled : MANDATORY BOOLEAN;
      automaticPublication : MANDATORY BOOLEAN;
      definitionKey : MANDATORY TEXT*128;
      definitionSha256 : MANDATORY Sha256;
      allowedModes : MANDATORY (replace_only, append_only, replace_and_append);
    END CsvDeliveryConfiguration;

    !!@ di.audit=full
    CLASS AttributeDefinition =
      name : MANDATORY TEXT*255;
      dataType : MANDATORY TEXT*255;
      ordinal : MANDATORY Positive;
      mandatory : MANDATORY BOOLEAN;
      description : MTEXT;
      unit : TEXT*255;
      codeList : INTERLIS.URI;
    END AttributeDefinition;

    !!@ di.audit=full
    CLASS DataVersion =
      versionKey : MANDATORY TEXT*128;
      sequence : MANDATORY Positive;
      availability : MANDATORY Availability;
      acceptedAt : EventTime;
      sourceSha256 : Sha256;
      objectCount : NonNegative;
      attributeCount : NonNegative;
      validationStatus : MANDATORY (unknown, success, fail);
      validationAt : EventTime;
      validationErrors : NonNegative;
      validationReportKey : TEXT*1024;
      sourceReference : TEXT*1024;
      MANDATORY CONSTRAINT availability != #available OR DEFINED(acceptedAt);
      MANDATORY CONSTRAINT availability != #available OR validationStatus != #fail;
    END DataVersion;

    !!@ di.audit=full
    CLASS Distribution =
      format : MANDATORY DistributionFormat;
      fileName : MANDATORY SafeFileName;
      mediaType : MANDATORY TEXT*255;
      availability : MANDATORY Availability;
      byteSize : NonNegative;
      sha256 : Sha256;
      objectKey : MANDATORY TEXT*1024;
      UNIQUE objectKey;
      MANDATORY CONSTRAINT availability != #available OR (DEFINED(byteSize) AND DEFINED(sha256));
    END Distribution;

    !!@ di.audit=full
    CLASS DatasetTheme =
      theme : MANDATORY Theme;
    END DatasetTheme;

    !!@ di.audit=full
    CLASS DatasetKeyword =
      keyword : MANDATORY TEXT*255;
    END DatasetKeyword;

    !!@ di.audit=full
    ASSOCIATION DatasetOwner =
      ownerOffice -- {1} Office;
      ownedDatasets -- {0..*} Dataset;
    END DatasetOwner;

    !!@ di.audit=full
    ASSOCIATION DatasetPublisher =
      publisherOffice -- {1} Office;
      publishedDatasets -- {0..*} Dataset;
    END DatasetPublisher;

    !!@ di.audit=full
    ASSOCIATION IssueDataset =
      dataset -- {1} Dataset;
      issues -- {0..*} DatasetIssue;
    END IssueDataset;

    !!@ di.audit=full
    ASSOCIATION VersionIssue =
      issue -- {1} DatasetIssue;
      versions -- {0..*} DataVersion;
    END VersionIssue;

    !!@ di.audit=full
    ASSOCIATION DistributionVersion =
      version -- {1} DataVersion;
      distributions -- {0..*} Distribution;
    END DistributionVersion;

    !!@ di.audit=full
    ASSOCIATION VersionSchema =
      schema -- {0..1} DataSchema;
      usingVersions -- {0..*} DataVersion;
    END VersionSchema;

    !!@ di.audit=full
    ASSOCIATION AttributeSchema =
      schema -- {1} DataSchema;
      attributes -- {0..*} AttributeDefinition;
    END AttributeSchema;

    !!@ di.audit=full
    ASSOCIATION CurrentIssue =
      currentIssue -- {0..1} DatasetIssue;
      currentForDatasets -- {0..*} Dataset;
    END CurrentIssue;

    !!@ di.audit=full
    ASSOCIATION CurrentVersion =
      currentVersion -- {0..1} DataVersion;
      currentForIssues -- {0..*} DatasetIssue;
    END CurrentVersion;

    !!@ di.audit=full
    ASSOCIATION ThemeDataset =
      dataset -- {1} Dataset;
      themes -- {0..*} DatasetTheme;
    END ThemeDataset;

    !!@ di.audit=full
    ASSOCIATION KeywordDataset =
      dataset -- {1} Dataset;
      keywords -- {0..*} DatasetKeyword;
    END KeywordDataset;

    !!@ di.audit=full
    ASSOCIATION CsvDeliveryDataset =
      dataset -- {1} Dataset;
      csvDeliveryConfiguration -- {0..1} CsvDeliveryConfiguration;
    END CsvDeliveryDataset;

    !!@ di.audit=full
    ASSOCIATION CsvDeliverySchema =
      schema -- {1} DataSchema;
      csvDeliveryConfigurations -- {0..*} CsvDeliveryConfiguration;
    END CsvDeliverySchema;

    CONSTRAINTS OF CsvDeliveryConfiguration =
      UNIQUE dataset;
    END;
    CONSTRAINTS OF DatasetIssue =
      UNIQUE dataset, issueKey;
    END;
    CONSTRAINTS OF DataVersion =
      UNIQUE issue, versionKey;
      UNIQUE issue, sequence;
    END;
    CONSTRAINTS OF AttributeDefinition =
      UNIQUE schema, name;
      UNIQUE schema, ordinal;
    END;
    CONSTRAINTS OF DatasetTheme =
      UNIQUE dataset, theme;
    END;
    CONSTRAINTS OF DatasetKeyword =
      UNIQUE dataset, keyword;
    END;
  END Catalog;
END SO_AGI_DataInfrastructure_Catalog_20261105.
