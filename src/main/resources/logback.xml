<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%d{ISO8601} %-5level %logger{36} - %msg%n</pattern></encoder></appender>
  <logger name="cayenne-sql" level="OFF"/>
  <logger name="org.apache.cayenne.log" level="ERROR"/>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
